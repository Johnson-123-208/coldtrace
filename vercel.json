{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd web && npm ci && npm run build",
  "outputDirectory": "web/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://coldtrace-api-xt2c.onrender.com/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://coldtrace-api-xt2c.onrender.com/api/health"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
